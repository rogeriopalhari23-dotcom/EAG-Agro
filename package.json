{
  "name": "eag-compass",
  "version": "0.3.1-review.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "predev": "npm run build:site",
    "dev": "wrangler dev --env local --local --ip 127.0.0.1",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply eag-compass-db --env local --local",
    "db:migrate:remote": "node scripts/validate-deploy.mjs && wrangler d1 migrations apply eag-compass-db --remote",
    "predeploy": "npm run check && node scripts/validate-deploy.mjs",
    "deploy": "wrangler deploy",
    "test:worker": "node --test tests/worker.integration.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "next": "node scripts/next-task.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260921.0-alpha",
    "wrangler": "4.136.1"
  },
  "dependencies": {
    "jose": "6.2.12",
    "worker-mailer": "1.2.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
