{
  "name": "eag-compass",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "predev": "npm run build:site",
    "dev": "wrangler dev --local",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/worker.js && node --check src/scoring.js && node --test tests/*.test.mjs && npm run build:site && npm run validate:site",
    "db:migrate:local": "wrangler d1 migrations apply eag-compass-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply eag-compass-db --remote",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
