{
  "name": "eag-compass",
  "version": "0.1.0",
  "description": "EAG Compass: Discover and qualify agricultural commodity importers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build": "tsc",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "vitest",
    "migrate": "wrangler migrations apply --local",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "unidecode": "^0.1.8",
    "rapid-fuzz": "^1.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240919.0",
    "wrangler": "^3.45.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "prettier": "^3.1.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
