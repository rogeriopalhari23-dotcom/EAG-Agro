{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker e D1 já existentes na conta (decisão de Rogério em 2026-09-24; inventário em EVIDENCIAS P1-T3).
  "name": "eag-compass-production",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  // Endereço: workers.dev da conta atrás do Access (decisão de 2026-09-24); sem Access a API responde 401.
  "workers_dev": true,
  // Domínio próprio ligado em 2026-09-25 (zona eagcompass.com). Transição: workers.dev segue ativo até a zona ativar e o
  // Access cobrir eagcompass.com; depois `workers_dev: false` e PUBLIC_BASE_URL = https://eagcompass.com.
  "routes": [{ "pattern": "eagcompass.com", "custom_domain": true }],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_LOCAL_AUTH": "false",
    "DEFAULT_TENANT_ID": "eag-internal",
    "ACCESS_TEAM_DOMAIN": "https://quiet-bird-4d88.cloudflareaccess.com",
    "ACCESS_AUD": "dceee9f35553eef827d15e9ec6d0ac59747283b83e15340db966c4657f4a080f",
    // E-mail (P2-T17): remetente fixado na Spec R19.13; endereço físico da EAG em docs/eag-compass-perfil.md (eagagro.com/contato).
    // Teste interno só para o endereço autorizado por Rogério em 2026-09-24. A senha da caixa é segredo (MAILBOX_PASSWORD).
    "PUBLIC_BASE_URL": "https://eag-compass-production.rogeriopalhari23.workers.dev",
    // Nome exibido no campo De dos e-mails (decisão de Rogério, 2026-09-30). O nome da pessoa no texto e na assinatura é SENDER_PERSON_NAME.
    "SENDER_NAME": "EAG Agro - Brasil",
    "SENDER_PERSON_NAME": "Rogério Palhari",
    // Ponte de e-mail (opção B, computador de Rogério, 2026-09-30): o cron não fala com a caixa; a ponte transporta pelas rotas /api/bridge/*.
    "SEND_TRANSPORT": "bridge",
    // BRIDGE_ACCESS_CLIENT_ID (token de serviço da ponte) e BRIDGE_ACCESS_AUD (aplicação do Access só de /api/bridge) são
    // secrets do Worker, gravados pela API na configuração do Access; sem eles as rotas da ponte recusam.
    "MAILBOX_USER": "rogeriopalhari@eagagro.com",
    "EAG_POSTAL_ADDRESS": "Al. Rio Negro, 503 — Alphaville Industrial, Barueri/SP, Brasil",
    // Validação de Rogério (2026-09-30): texto exato do endereço do rodapé. Sem ele (ou diferente), revisor e aprovação bloqueiam.
    "EAG_POSTAL_ADDRESS_CONFIRMED": "Al. Rio Negro, 503 — Alphaville Industrial, Barueri/SP, Brasil",
    // Teste interno da ponte (2026-09-30): aliases "+" entregam na mesma caixa do Gmail de Rogério (um por cenário).
    "INTERNAL_TEST_RECIPIENTS": "rogeriopalhari23@gmail.com,rogeriopalhari23+ponte-a@gmail.com,rogeriopalhari23+ponte-b@gmail.com,rogeriopalhari23+ponte-c@gmail.com,rogeriopalhari23+ponte-link@gmail.com",
    // MDIC lido pelo workflow mensal do GitHub (scripts/mdic-job.mjs): o fetch do Worker responde 526 porque o
    // servidor do MDIC não envia o certificado intermediário (EVIDENCIAS, 2026-09-25). O Worker cuida só da Comtrade.
    "MDIC_SOURCE": "github",
    // Mapa de fundo (redesign, 2026-10-01): manifesto do recorte Protomaps no R2 privado (prefixo mapa/).
    "MAP_MANIFEST_KEY": "mapa/brasil-20260929-z12/manifest.json"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/u/*"
    ],
    "not_found_handling": "none"
  },
  // Descadastro público (/u/*): limite por token. namespace_id único na conta; período 10 ou 60 s (doc Rate Limiting).
  // Fila e cron liberados por Rogério em 2026-09-24 (disparo comercial segue bloqueado: canal de e-mail "planned").
  "queues": {
    "producers": [{ "binding": "ASYNC_QUEUE", "queue": "eag-compass-async" }],
    "consumers": [{ "queue": "eag-compass-async", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "eag-compass-dlq" }]
  },
  "triggers": { "crons": ["*/5 * * * *", "17 2 * * *"] },
  // R2 habilitado por Rogério em 2026-09-25: lista mensal de compras por país (P3-T5). Bucket privado.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "eag-compass-files" }],
  "ratelimits": [
    {
      "name": "UNSUB_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eag_compass",
      "database_id": "d6a5873b-f768-4516-96b8-1f865db8aaa4",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "name": "eag-compass-local",
      "vars": {
        "ENVIRONMENT": "local",
        "ALLOW_LOCAL_AUTH": "true",
        "LOCAL_USER_EMAIL": "admin@local.eag",
        "DEFAULT_TENANT_ID": "eag-internal"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eag-compass-db",
          "database_id": "LOCAL_REPLACE_AFTER_CREATE",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
