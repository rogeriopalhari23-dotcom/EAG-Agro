# Apenas documentação. Wrangler local lê .dev.vars.local; produção usa wrangler secret put.
PII_ENCRYPTION_KEY=
SUPPRESSION_HMAC_KEY=
# Valores não secretos ficam em wrangler.jsonc:
# ENVIRONMENT, ALLOW_LOCAL_AUTH, DEFAULT_TENANT_ID, ACCESS_TEAM_DOMAIN, ACCESS_AUD
# Provedores do piloto nacional (secrets; sem valor aqui):
CASADOSDADOS_API_KEY=
