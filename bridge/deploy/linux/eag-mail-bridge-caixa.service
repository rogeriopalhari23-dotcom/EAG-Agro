# Conferência só da caixa (IMAP 993 e login SMTP), sem Compass e sem enviar: `ponte caixa`.
[Unit]
Description=EAG Compass - ponte: conferência da caixa (sem envio)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eagbridge
Group=eagbridge
WorkingDirectory=/opt/eag-mail-bridge/bridge
EnvironmentFile=/etc/eag-mail-bridge/config.env
Environment=BRIDGE_JOURNAL=/var/lib/eag-mail-bridge/conferencia.sqlite
LoadCredential=MAILBOX_PASSWORD:/etc/eag-mail-bridge/MAILBOX_PASSWORD
ExecStart=/usr/bin/node src/main.js --mailbox-only
StateDirectory=eag-mail-bridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
