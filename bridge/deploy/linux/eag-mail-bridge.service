# Ponte de e-mail do EAG Compass — serviço systemd (servidor independente, ex.: Hetzner CX23).
# Segredos em /etc/eag-mail-bridge/ (root, 0600), entregues só a este serviço por LoadCredential=.
[Unit]
Description=EAG Compass - ponte de e-mail (SMTP/IMAP Hostinger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eagbridge
Group=eagbridge
WorkingDirectory=/opt/eag-mail-bridge/bridge
EnvironmentFile=/etc/eag-mail-bridge/config.env
Environment=BRIDGE_JOURNAL=/var/lib/eag-mail-bridge/journal.sqlite
LoadCredential=MAILBOX_PASSWORD:/etc/eag-mail-bridge/MAILBOX_PASSWORD
LoadCredential=BRIDGE_HMAC_KEY:/etc/eag-mail-bridge/BRIDGE_HMAC_KEY
LoadCredential=ACCESS_CLIENT_SECRET:/etc/eag-mail-bridge/ACCESS_CLIENT_SECRET
ExecStart=/usr/bin/node src/main.js
Restart=always
RestartSec=30
StateDirectory=eag-mail-bridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
